// Personal Finance Dashboard — Prisma schema
// Provider is Postgres (free Neon tier) so data persists on Vercel.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum CategoryType {
  Fixed
  Variable
}

enum AccountType {
  Caisse
  Banque
  Autre
}

model Account {
  id             String             @id @default(cuid())
  label          String
  type           AccountType
  bankName       String?
  openingBalance Float              @default(0)
  isDefault      Boolean            @default(false)
  isActive       Boolean            @default(true)
  position       Int                @default(0)
  createdAt      DateTime           @default(now())
  expenses       Expense[]
  incomes        Income[]
  recurring      RecurringExpense[]
  transfersFrom  Transfer[]         @relation("TransferFrom")
  transfersTo    Transfer[]         @relation("TransferTo")
}

model Transfer {
  id            String   @id @default(cuid())
  amount        Float
  description   String   @default("")
  date          DateTime
  fromAccountId String
  fromAccount   Account  @relation("TransferFrom", fields: [fromAccountId], references: [id], onDelete: Restrict)
  toAccountId   String
  toAccount     Account  @relation("TransferTo", fields: [toAccountId], references: [id], onDelete: Restrict)
  createdAt     DateTime @default(now())

  @@index([date])
  @@index([fromAccountId])
  @@index([toAccountId])
}

model Income {
  id          String   @id @default(cuid())
  amount      Float
  description String
  date        DateTime
  accountId   String?
  account     Account? @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt   DateTime @default(now())

  @@index([date])
  @@index([accountId])
}

model Expense {
  id            String      @id @default(cuid())
  amount        Float
  description   String
  date          DateTime
  paymentMethod String
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  accountId     String?
  account       Account?    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  createdAt     DateTime    @default(now())

  @@index([date])
  @@index([subcategoryId])
  @@index([accountId])
}

model Category {
  id              String           @id @default(cuid())
  name            String
  type            CategoryType
  position        Int              @default(0)
  createdAt       DateTime         @default(now())
  subcategories   Subcategory[]
  categoryBudgets CategoryBudget[]

  @@index([type])
}

model CategoryBudget {
  id         String   @id @default(cuid())
  categoryId String
  category   Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  month      Int
  year       Int
  amount     Float
  rollover   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([categoryId, month, year])
  @@index([categoryId])
}

model SubcategoryBudget {
  id            String      @id @default(cuid())
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  month         Int
  year          Int
  amount        Float
  rollover      Boolean     @default(false)
  createdAt     DateTime    @default(now())

  @@unique([subcategoryId, month, year])
  @@index([subcategoryId])
}

model Subcategory {
  id                String             @id @default(cuid())
  name              String
  categoryId        String
  category          Category           @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  position          Int                 @default(0)
  createdAt         DateTime            @default(now())
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  budgets           SubcategoryBudget[]

  @@index([categoryId])
}

model Budget {
  id            String   @id @default(cuid())
  month         Int
  year          Int
  monthlyBudget Float
  savingGoal    Float    @default(0)
  createdAt     DateTime @default(now())

  @@unique([month, year])
}

model RecurringExpense {
  id            String      @id @default(cuid())
  amount        Float
  description   String      @default("")
  dayOfMonth    Int         @default(1)
  subcategoryId String
  subcategory   Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)
  accountId     String?
  account       Account?    @relation(fields: [accountId], references: [id], onDelete: Restrict)
  active        Boolean     @default(true)
  createdAt     DateTime    @default(now())

  @@index([subcategoryId])
  @@index([accountId])
}

// Simple key/value store (used for the runtime password override).
model Setting {
  key   String @id
  value String
}
