# The single password used to unlock the dashboard.
APP_PASSWORD="myPassword123"

# Free Neon Postgres connection string (https://neon.tech).
# Local dev can also point at any local Postgres instance.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/dbname?sslmode=require"

# Long random string used to sign the session cookie (HMAC).
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET="change-me-to-a-long-random-string"

# MCP connector (Claude.ai custom connector). Public origin of this deployment,
# no trailing slash. The MCP endpoint is served at <MCP_PUBLIC_BASE_URL>/api/mcp.
MCP_PUBLIC_BASE_URL="https://mlmonthlybudget.me"

# Separate secret (>= 32 chars) used to sign OAuth client ids, codes and tokens.
# Rotating it revokes every connector token and client registration.
MCP_TOKEN_SECRET="change-me-to-another-long-random-string"

# Optional comma-separated allowlist of OAuth redirect URIs. Defaults to Claude's
# callbacks (claude.ai and claude.com). Add the MCP Inspector callback for local testing.
# MCP_ALLOWED_REDIRECT_URIS="https://claude.ai/api/mcp/auth_callback,https://claude.com/api/mcp/auth_callback,http://localhost:6274/oauth/callback"

# Optional pino log level (trace, debug, info, warn, error). Defaults to info in production.
# LOG_LEVEL="info"
